{
  "name": "@forever-professions/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/handler.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/local.ts",
    "validate:guide": "tsx scripts/validate-guide.ts",
    "optimize": "tsx scripts/optimize.ts",
    "request": "tsx scripts/request.ts",
    "shopping": "tsx scripts/shopping.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "tsx src/local.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@forever-professions/contracts": "workspace:*",
    "@forever-professions/fixtures": "workspace:*",
    "@forever-professions/ingestion": "workspace:*",
    "@forever-professions/optimizer": "workspace:*",
    "@forever-professions/pricing": "workspace:*",
    "@forever-professions/shopping": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
