# Optional named AWS profile used by boto3 and inherited by pnpm AWS jobs.
AWS_PROFILE=your-non-root-profile
ADMIN_AWS_PROFILE=your-non-root-profile
ADMIN_AWS_REGION=us-east-1

# Installed client used for metadata and icon enrichment. Source archives are
# discovered, downloaded, verified, and cached by the admin panel.
WOW_CLIENT_ROOT=C:\World of Warcraft
WOW_CLIENT_PRODUCT=wowf

# Staging data-stack outputs.
STAGING_DSQL_ENDPOINT=
STAGING_RAW_DATA_BUCKET=
STAGING_INGESTION_ROLE_ARN=
STAGING_MIGRATION_ROLE_ARN=
STAGING_PRICING_WRITER_ROLE_ARN=
STAGING_APPLICATION_READER_ROLE_ARN=

# Production data-stack outputs.
PRODUCTION_DSQL_ENDPOINT=
PRODUCTION_RAW_DATA_BUCKET=
PRODUCTION_INGESTION_ROLE_ARN=
PRODUCTION_MIGRATION_ROLE_ARN=
PRODUCTION_PRICING_WRITER_ROLE_ARN=
PRODUCTION_APPLICATION_READER_ROLE_ARN=
