{
  "name": "forever-professions",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "data:audit": "pnpm --filter @forever-professions/ingestion audit:build",
    "data:convert:professiondb": "pnpm --filter @forever-professions/ingestion convert:professiondb",
    "data:enrich:client": "pnpm --filter @forever-professions/ingestion enrich:client-data",
    "data:import": "pnpm --filter @forever-professions/ingestion import:client-data",
    "data:import:local": "pnpm --filter @forever-professions/ingestion import:local",
    "data:release:dsql": "pnpm --filter @forever-professions/ingestion release:dsql",
    "guide:validate": "pnpm --filter @forever-professions/api validate:guide",
    "infra:bootstrap": "pnpm --filter @forever-professions/ops bootstrap",
    "infra:configure:github": "pnpm --filter @forever-professions/ops configure:github",
    "infra:protect:main": "pnpm --filter @forever-professions/ops configure:github:protect",
    "infra:deploy:delivery": "pnpm --filter @forever-professions/ops deploy:delivery",
    "infra:deploy:data:production": "pnpm --filter @forever-professions/ops deploy:data:production",
    "infra:deploy:data:staging": "pnpm --filter @forever-professions/ops deploy:data:staging",
    "infra:deploy:production": "pnpm --filter @forever-professions/ops deploy:production",
    "infra:deploy:staging": "pnpm --filter @forever-professions/ops deploy:staging",
    "infra:diff:production": "pnpm --filter @forever-professions/ops diff:production",
    "infra:diff:staging": "pnpm --filter @forever-professions/ops diff:staging",
    "infra:diff:data:production": "pnpm --filter @forever-professions/ops diff:data:production",
    "infra:diff:data:staging": "pnpm --filter @forever-professions/ops diff:data:staging",
    "infra:diff:delivery": "pnpm --filter @forever-professions/ops diff:delivery",
    "infra:synth:production": "pnpm --filter @forever-professions/ops synth:production",
    "infra:synth:staging": "pnpm --filter @forever-professions/ops synth:staging",
    "infra:synth:delivery": "pnpm --filter @forever-professions/ops synth:delivery",
    "api:request": "pnpm --filter @forever-professions/api request",
    "api:shopping": "pnpm --filter @forever-professions/api shopping",
    "api:optimize": "pnpm --filter @forever-professions/api optimize",
    "api:smoke": "pnpm --filter @forever-professions/api smoke",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "db:local:test": "pnpm --filter @forever-professions/ingestion test:local-db",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:roles:dsql": "pnpm --filter @forever-professions/ingestion bootstrap:dsql-roles",
    "db:dsql:test": "pnpm --filter @forever-professions/ingestion test:dsql",
    "db:migrate:dsql": "pnpm --filter @forever-professions/ingestion migrate:dsql",
    "dev:api": "pnpm --filter @forever-professions/api dev",
    "dev:web": "pnpm --filter @forever-professions/web dev",
    "pricing:live:test": "pnpm --filter @forever-professions/pricing test:live",
    "pricing:local:test": "pnpm --filter @forever-professions/pricing test:local-db",
    "pricing:dsql:test": "pnpm --filter @forever-professions/pricing test:dsql",
    "synth": "pnpm --filter @forever-professions/ops synth",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm synth"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
