{
  "name": "forever-professions",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "data:import": "pnpm --filter @forever-professions/ingestion import:client-data",
    "api:request": "pnpm --filter @forever-professions/api request",
    "api:shopping": "pnpm --filter @forever-professions/api shopping",
    "api:optimize": "pnpm --filter @forever-professions/api optimize",
    "api:smoke": "pnpm --filter @forever-professions/api smoke",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "db:local:test": "pnpm --filter @forever-professions/ingestion test:local-db",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:dsql:test": "pnpm --filter @forever-professions/ingestion test:dsql",
    "dev:api": "pnpm --filter @forever-professions/api dev",
    "dev:web": "pnpm --filter @forever-professions/web dev",
    "pricing:live:test": "pnpm --filter @forever-professions/pricing test:live",
    "pricing:local:test": "pnpm --filter @forever-professions/pricing test:local-db",
    "pricing:dsql:test": "pnpm --filter @forever-professions/pricing test:dsql",
    "synth": "pnpm --filter @forever-professions/ops synth",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm synth"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
