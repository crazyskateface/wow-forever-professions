{
  "name": "@forever-professions/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "audit:build": "tsx scripts/audit-build.ts",
    "bootstrap:dsql-roles": "tsx scripts/bootstrap-dsql-roles.ts",
    "build": "tsc -p tsconfig.json",
    "convert:professiondb": "tsx scripts/convert-professiondb.ts",
    "enrich:client-data": "tsx scripts/enrich-client-data.ts",
    "import:client-data": "tsx scripts/import-client-data.ts",
    "import:local": "tsx scripts/import-local.ts",
    "migrate:dsql": "tsx scripts/migrate-dsql.ts",
    "release:dsql": "tsx scripts/release-dsql.ts",
    "status:local": "tsx scripts/status-local.ts",
    "test": "vitest run",
    "test:dsql": "tsx scripts/dsql-smoke.ts",
    "test:local-db": "tsx local/postgres-smoke.ts",
    "typecheck:local": "tsc -p tsconfig.local.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/credential-providers": "3.1147.0",
    "@aws/aurora-dsql-node-postgres-connector": "0.1.9",
    "@forever-professions/contracts": "workspace:*",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
