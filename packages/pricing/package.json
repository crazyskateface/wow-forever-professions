  "devDependencies": {
    "@aws-sdk/credential-providers": "3.1147.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
